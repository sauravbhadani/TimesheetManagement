{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "TimesheetDb": ""
  },

  "Auth": {
    "Provider": "Local",
    "Local": {
      "Issuer": "TimesheetManagement.Local",
      "Audience": "TimesheetManagement.Api",
      "TokenLifetimeMinutes": 480
    },
    "EntraId": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "ClientId": "",
      "Audience": ""
    }
  },

  "Timesheet": {
    "WeekStartDayOfWeek": "Monday",
    "MaxHoursPerDay": 24,
    "WarnHoursPerDayThreshold": 10,
    "EnforceHardCap": false
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
